<?xml version="1.0" encoding="UTF-8"?>
<!--
  ENVLP 2 schematic schema.

  Electrical truth lives in <netlist>.  <schematic> is visual-only and may be
  omitted, empty, stale, or regenerated by the editor.  In particular a <wire>
  never creates a connection: the component <pin net="..."/> attributes do.
-->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="unqualified"
           attributeFormDefault="unqualified">

  <xs:element name="envlp">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="netlist" type="netlistType"/>
        <xs:element name="schematic" type="schematicType" minOccurs="0"/>
      </xs:sequence>
      <xs:attribute name="version" type="xs:string" use="optional"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="netlistType">
    <xs:sequence>
      <xs:element name="tech" type="techType" minOccurs="0"/>
      <xs:element name="request" type="requestType" minOccurs="0"/>
      <xs:element name="components" type="componentsType" minOccurs="0"/>
      <xs:element name="analyses" type="analysesType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="techType">
    <xs:attribute name="dc-mode" type="xs:int" use="optional"/>
    <xs:attribute name="vdd" type="xs:double" use="optional"/>
    <xs:attribute name="vthn" type="xs:double" use="optional"/>
    <xs:attribute name="vthp" type="xs:double" use="optional"/>
    <xs:attribute name="is" type="xs:double" use="optional"/>
    <xs:attribute name="uncox" type="xs:double" use="optional"/>
    <xs:attribute name="upcox" type="xs:double" use="optional"/>
    <xs:attribute name="assume-saturation" type="xs:boolean" use="optional"/>
    <xs:attribute name="include-clm" type="xs:boolean" use="optional"/>
  </xs:complexType>

  <xs:complexType name="requestType">
    <xs:attribute name="input" type="xs:string" use="optional"/>
    <xs:attribute name="output" type="xs:string" use="optional"/>
    <xs:attribute name="f0" type="xs:double" use="optional"/>
    <xs:attribute name="f-start" type="xs:double" use="optional"/>
    <xs:attribute name="f-stop" type="xs:double" use="optional"/>
    <xs:attribute name="sweep" type="xs:int" use="optional"/>
    <xs:attribute name="points" type="xs:int" use="optional"/>
    <xs:attribute name="prune" type="xs:boolean" use="optional"/>
    <xs:attribute name="parallel" type="xs:boolean" use="optional"/>
    <xs:attribute name="approx" type="xs:boolean" use="optional"/>
    <xs:attribute name="pole-ref" type="xs:int" use="optional"/>
    <xs:attribute name="component-threshold" type="xs:double" use="optional"/>
    <xs:attribute name="pole-zero-threshold" type="xs:double" use="optional"/>
    <xs:attribute name="threshold-db" type="xs:double" use="optional"/>
    <xs:attribute name="pole-zero-threshold-db" type="xs:double" use="optional"/>
    <xs:attribute name="global" type="xs:boolean" use="optional"/>
    <xs:attribute name="normalize" type="xs:boolean" use="optional"/>
  </xs:complexType>

  <xs:complexType name="componentsType">
    <xs:sequence>
      <xs:element name="component" type="componentType" minOccurs="0"
                  maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="componentType">
    <xs:sequence>
      <xs:element name="description" type="xs:string" minOccurs="0"/>
      <xs:element name="pin" type="pinType" minOccurs="0"
                  maxOccurs="unbounded"/>
      <xs:element name="source" type="sourceType" minOccurs="0"/>
      <xs:element name="parameter" type="parameterType" minOccurs="0"
                  maxOccurs="unbounded"/>
      <xs:element name="mirror" type="mirrorType" minOccurs="0"/>
      <xs:element name="link" type="linkType" minOccurs="0"
                  maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="kind" type="xs:string" use="required"/>
    <xs:attribute name="value" type="xs:string" use="optional"/>
    <xs:attribute name="size-db" type="xs:int" use="optional"/>
  </xs:complexType>

  <xs:complexType name="pinType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="net" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="sourceType">
    <xs:attribute name="dc" type="xs:string" use="optional"/>
    <xs:attribute name="ac" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="parameterType">
    <xs:attribute name="name" type="xs:string" use="required"/>
    <xs:attribute name="enabled" type="xs:boolean" use="optional"/>
    <xs:attribute name="value" type="xs:string" use="optional"/>
    <xs:attribute name="db" type="xs:int" use="optional"/>
  </xs:complexType>

  <xs:complexType name="mirrorType">
    <xs:attribute name="ref" type="xs:string" use="required"/>
    <xs:attribute name="mult" type="xs:int" use="optional"/>
    <xs:attribute name="den" type="xs:int" use="optional"/>
  </xs:complexType>

  <xs:complexType name="linkType">
    <xs:attribute name="ref" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="analysesType">
    <xs:choice minOccurs="0" maxOccurs="unbounded">
      <xs:element name="analysis" type="analysisType"/>
      <xs:element name="card" type="xs:string"/>
    </xs:choice>
  </xs:complexType>

  <xs:complexType name="analysisType">
    <xs:attribute name="kind" type="xs:string" use="optional"/>
    <xs:attribute name="input" type="xs:string" use="optional"/>
    <xs:attribute name="output" type="xs:string" use="optional"/>
    <xs:attribute name="probe" type="xs:string" use="optional"/>
    <xs:attribute name="title" type="xs:string" use="optional"/>
    <xs:attribute name="f-start" type="xs:double" use="optional"/>
    <xs:attribute name="f-stop" type="xs:double" use="optional"/>
    <xs:attribute name="sweep" type="xs:int" use="optional"/>
    <xs:attribute name="points" type="xs:int" use="optional"/>
    <xs:attribute name="prune" type="xs:boolean" use="optional"/>
    <xs:attribute name="parallel" type="xs:boolean" use="optional"/>
    <xs:attribute name="enabled" type="xs:boolean" use="optional"/>
    <xs:attribute name="approx" type="xs:boolean" use="optional"/>
    <xs:attribute name="port-p" type="xs:string" use="optional"/>
    <xs:attribute name="port-n" type="xs:string" use="optional"/>
    <xs:attribute name="component-threshold" type="xs:double" use="optional"/>
    <xs:attribute name="pole-zero-threshold" type="xs:double" use="optional"/>
    <xs:attribute name="pole-ref" type="xs:int" use="optional"/>
  </xs:complexType>

  <xs:complexType name="schematicType">
    <xs:sequence>
      <xs:element name="placements" type="placementsType" minOccurs="0"/>
      <xs:element name="wires" type="wiresType" minOccurs="0"/>
      <xs:element name="junctions" type="junctionsType" minOccurs="0"/>
      <xs:element name="labels" type="labelsType" minOccurs="0"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="placementsType">
    <xs:sequence>
      <xs:element name="placement" type="placementType" minOccurs="0"
                  maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="placementType">
    <xs:attribute name="ref" type="xs:string" use="required"/>
    <xs:attribute name="x" type="xs:double" use="required"/>
    <xs:attribute name="y" type="xs:double" use="required"/>
    <xs:attribute name="rot" type="xs:int" use="optional"/>
    <xs:attribute name="flip-h" type="xs:boolean" use="optional"/>
    <xs:attribute name="flip-v" type="xs:boolean" use="optional"/>
  </xs:complexType>

  <xs:complexType name="wiresType">
    <xs:sequence>
      <xs:element name="wire" type="wireType" minOccurs="0"
                  maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="wireType">
    <xs:sequence>
      <xs:element name="start" type="endpointType" minOccurs="0"/>
      <xs:element name="end" type="endpointType" minOccurs="0"/>
      <xs:element name="point" type="pointType" minOccurs="0"
                  maxOccurs="unbounded"/>
      <xs:element name="waypoint" type="pointType" minOccurs="0"
                  maxOccurs="unbounded"/>
      <xs:element name="pin-point" type="pinPointType" minOccurs="0"
                  maxOccurs="unbounded"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="net" type="xs:string" use="optional"/>
  </xs:complexType>

  <xs:complexType name="endpointType">
    <xs:attribute name="ref" type="xs:string" use="optional"/>
    <xs:attribute name="pin" type="xs:string" use="optional"/>
    <xs:attribute name="x" type="xs:double" use="optional"/>
    <xs:attribute name="y" type="xs:double" use="optional"/>
  </xs:complexType>

  <xs:complexType name="pointType">
    <xs:attribute name="x" type="xs:double" use="required"/>
    <xs:attribute name="y" type="xs:double" use="required"/>
  </xs:complexType>

  <xs:complexType name="pinPointType">
    <xs:attribute name="ref" type="xs:string" use="required"/>
    <xs:attribute name="pin" type="xs:string" use="required"/>
    <xs:attribute name="x" type="xs:double" use="required"/>
    <xs:attribute name="y" type="xs:double" use="required"/>
  </xs:complexType>

  <xs:complexType name="junctionsType">
    <xs:sequence>
      <xs:element name="junction" type="junctionType" minOccurs="0"
                  maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="junctionType">
    <xs:attribute name="id" type="xs:string" use="optional"/>
    <xs:attribute name="net" type="xs:string" use="optional"/>
    <xs:attribute name="x" type="xs:double" use="required"/>
    <xs:attribute name="y" type="xs:double" use="required"/>
  </xs:complexType>

  <xs:complexType name="labelsType">
    <xs:sequence>
      <xs:element name="label" type="labelType" minOccurs="0"
                  maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="labelType">
    <xs:attribute name="net" type="xs:string" use="required"/>
    <xs:attribute name="text" type="xs:string" use="optional"/>
    <xs:attribute name="x" type="xs:double" use="required"/>
    <xs:attribute name="y" type="xs:double" use="required"/>
    <xs:attribute name="text-x" type="xs:double" use="optional"/>
    <xs:attribute name="text-y" type="xs:double" use="optional"/>
    <xs:attribute name="font-size" type="xs:int" use="optional"/>
    <xs:attribute name="rotation" type="xs:int" use="optional"/>
  </xs:complexType>

</xs:schema>
