/* ENVLP Windows resources.
 *
 * The manifest is what makes Windows load Common-Controls 6.0, which
 * wxWidgets 3.3 requires (GetWindowSubclass & friends are exported by
 * name only from comctl32 v6). Resource id 1 with type 24 (RT_MANIFEST)
 * is the process manifest.
 *
 * The icon is declared twice from the same file: once with the integer id 1
 * (which is what Explorer and the taskbar use for the .exe) and once with a
 * *name*, because wxWidgets loads an icon resource by name, not by id.
 * ENVLP.ico is built from ENVLP.svg by tools/make_icon.ps1.
 *
 * VERSIONINFO gives the executable the metadata Windows shows in the
 * Properties dialog (publisher, product, version). It is what lets a user
 * see who produced the binary; Authenticode signing (tools/sign.ps1) is what
 * removes the SmartScreen warning. */
1 24 "ENVLP.manifest"
1 ICON "ENVLP.ico"
ENVLP_APP ICON "ENVLP.ico"

1 VERSIONINFO
  FILEVERSION    @ENVLP_VER_COMMA@
  PRODUCTVERSION @ENVLP_VER_COMMA@
  FILEFLAGSMASK  0x3fL
#ifdef _DEBUG
  FILEFLAGS      0x1L
#else
  FILEFLAGS      0x0L
#endif
  FILEOS         0x40004L
  FILETYPE       0x1L
  FILESUBTYPE    0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "@ENVLP_PUBLISHER@"
      VALUE "FileDescription",  "ENVLP -- symbolic circuit analyzer"
      VALUE "FileVersion",      "@ENVLP_VER_STR@"
      VALUE "InternalName",     "ENVLP"
      VALUE "OriginalFilename", "ENVLP.exe"
      VALUE "ProductName",      "ENVLP"
      VALUE "ProductVersion",   "@ENVLP_VER_STR@"
      VALUE "LegalCopyright",   "@ENVLP_COPYRIGHT@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
