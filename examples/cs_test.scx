envlp 1
req "V1" "V(out)" 1 1e+09 0 10 1 1 1
tech 0 0.6 1e-16 0.0002 0.0001 "" "nmos" "pmos" 0
comp "V1" "V" 290 300 0 0 0 0 "" dc=1
comp "R1" "R" 360 190 90 0 0 0 "1k"
comp "VDD" "VDD" 360 140 0 0 0 0 "10" dc=5
comp "GND2" "GND" 360 330 0 0 0 0 ""
comp "GND3" "GND" 440 320 0 0 0 0 ""
comp "M1" "NMOS" 360 270 0 0 0 0 ""
param "M1" "Cds" 1 "200f" 0
param "M1" "Cgd" 0 "" 0
comp "C1" "C" 440 260 90 0 0 0 "1p"
comp "GND1" "GND" 290 350 0 0 0 0 ""
wire 360,140 360,160 pin:VDD:0 pin:R1:1
wire 360,330 360,310 pin:GND2:0 pin:M1:2
wire 360,230 360,230 pin:M1:0 pin:M1:0
wire 360,230 360,220 pin:M1:0 pin:R1:0
wire 440,320 440,290 pin:GND3:0 pin:C1:0
wire 440,230 360,230 360,220 pin:C1:1 pin:R1:0
wire 290,350 290,330 pin:GND1:0 pin:V1:1
wire 290,270 320,270 pin:V1:0 pin:M1:1
netlabel 294.008,270 303.588,259.25 "in" 9 0 bind=7:0.133604
netlabel 425.549,230 425.549,219.25 "out" 9 0 bind=5:0.160563
card "Output impedance" "V1" "V(out)" "" 1 1e+09 0 10 1 1 1 "Output impedance" 0 "" "" 10 1000 0
card "Transfer function (H(s))" "V1" "V(out)" "" 1 1e+09 0 10 1 1 1 "Transfer function (H(s))" 0 "" "" 10 1000 0
card "Short-circuit current" "V1" "V(out)" "" 1 1e+09 0 10 1 1 1 "Short-circuit current" 1 "" "" 10 1000 0
card "Noise" "V1" "V(out)" "" 1 1e+09 0 10 1 1 1 "Noise" 0 "" "" 10 1000 0
card "PSR / PSRR" "V1" "V(out)" "" 1 1e+09 0 10 1 1 1 "PSR / PSRR" 1 "" "" 10 1000 0
