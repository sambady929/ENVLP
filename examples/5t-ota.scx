param "M4" "Cds" 0 "33f" 0
param "M4" "Cgd" 0 "10f" 0
param "M4" "Cgs" 1 "100f" 0
comp "VDD" "VDD" 410 30 0 0 0 0 "5"
comp "V1" "V" 260 280 0 0 0 0 ""
comp "GND1" "GND" 260 320 0 0 0 0 ""
