symcirc 1
req "V1" "V(out)" 1000 40 1
comp "V1" "V" 80 200 270 0 "1"
comp "R1" "R" 200 100 0 0 "10k"
comp "C1" "C" 300 200 0 0 "1n"
comp "GND1" "GND" 80 300 0 0 ""
comp "GND2" "GND" 330 300 0 0 ""
wire 80,230 80,300
wire 80,170 80,100 170,100
wire 230,100 270,100 270,200
wire 330,200 330,300
netlabel 80,170 "in"
netlabel 270,200 "out"
